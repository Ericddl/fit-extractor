# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
/.fit-extractor.lock
venv/
*.egg-info/

# Données d'entraînement perso (fichiers .fit + exports)
/import/*
/export/*
!/import/.gitkeep
!/export/.gitkeep

# Filet de sécurité : aucune donnée d'activité ne doit être committée,
# où qu'elle se trouve dans l'arborescence
*.fit
*.fit.gz
*.gpx
*.tcx

# Outils IA (config locale, non partagée)
/.codex-tasks/
.claude/settings.local.json

# Éditeur / OS
.DS_Store
.idea/
.vscode/
*.swp

# Artefacts locaux de synchronisation Nextcloud / ownCloud
# Journaux SQLite (y compris WAL/SHM), logs et transferts incomplets.
.sync_*.db*
._sync_*.db*
.csync_journal.db*
.owncloudsync.log*
.nextcloudsync.log*
.nextcloudpermissions.log*
*.part
*.filepart
